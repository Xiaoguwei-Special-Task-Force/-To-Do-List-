from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from typing import List, Optional
from uuid import uuid4
import uvicorn
import subprocess

app = FastAPI(title="Intelligent To-Do List Management System", version="1.0")

# 模型定义
default_status = "未开始"

class TaskCreate(BaseModel):
    title: str
    description: str = ""
    deadline: str = ""
    status: str = default_status

class TaskUpdate(BaseModel):
    title: Optional[str] = None
    description: Optional[str] = None
    deadline: Optional[str] = None
    status: Optional[str] = None

class Task(TaskCreate):
    id: str
    category: str  # 分类结果

# 模拟 C++ 智能分类模块调用
def classify_task_cpp(title: str) -> str:
    # 假装通过 subprocess 调用已编译的 C++ 程序
    # 实际使用时可改为: result = subprocess.run(["./classifier", title], capture_output=True, text=True)
    # return result.stdout.strip()
    return "模拟分类"  # 暂用模拟结果

# 模拟数据库
tasks_db: List[Task] = []

# 启动时打印已注册路由，方便调试
@app.on_event("startup")
def print_routes():
    for route in app.routes:
        print(route.methods, route.path)

# 获取任务列表
@app.get("/tasks", tags=["tasks"])
def read_tasks():
    return {"tasks": tasks_db}

# 添加任务（包含智能分类）
@app.post("/tasks", tags=["tasks"])
def create_task(task: TaskCreate):
    # 调用 C++ 智能分类模块，获取分类
    category = classify_task_cpp(task.title)
    new_task = Task(id=str(uuid4()), category=category, **task.dict())
    tasks_db.append(new_task)
    return {"message": "任务添加成功", "task": new_task}

# 更新任务
@app.put("/tasks/{id}", tags=["tasks"])
def update_task(id: str, task_update: TaskUpdate):
    for task in tasks_db:
        if task.id == id:
            update_data = task_update.dict(exclude_unset=True)
            for key, value in update_data.items():
                setattr(task, key, value)
            return {"message": "任务更新成功", "task": task}
    raise HTTPException(status_code=404, detail="未找到对应的任务")

# 删除任务
@app.delete("/tasks/{id}", tags=["tasks"])
def delete_task(id: str):
    global tasks_db
    for task in tasks_db:
        if task.id == id:
            tasks_db = [t for t in tasks_db if t.id != id]
            return {"message": f"任务 {id} 删除成功"}
    raise HTTPException(status_code=404, detail="未找到对应的任务")

if __name__ == "__main__":
    uvicorn.run("main:app", host="127.0.0.1", port=8000, reload=True)
